{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": [
      "cypress",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../modules/**/*.ts",
    "../modules/**/*.tsx",
  ],
  "paths": {
    "cypress-react-unit-test": [
      "../lib"
    ],
  }
}