{
  "name": "shop-mate-nextjs",
  "version": "1.0.0",
  "engines": {
    "node": "10.19.0"
  },
  "scripts": {
    "dev": "next dev -p 5009",
    "dev:test": "cypress open",
    "dev:start": "next dev -p 5009",
    "start": "next start -p $PORT",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true npm run build",
    "ci": "npm run ci:setup && start-server-and-test dev:start http://localhost:5009 test",
    "ci:setup": "npm i && npm i -D cypress@5.3.0",
    "ci:visual": "start-server-and-test dev:start http://localhost:5009 test:visual",
    "ci:priority:1": "start-server-and-test dev:start http://localhost:5009 test:priority:1",
    "ci:priority:2": "start-server-and-test dev:start http://localhost:5009 test:priority:2",
    "ci:priority:3": "start-server-and-test dev:start http://localhost:5009 test:priority:3",
    "ci:priority:4": "start-server-and-test dev:start http://localhost:5009 test:priority:4",
    "test": "percy exec -- cypress run",
    "test:visual": "percy exec -- cypress run --env tags='#visual-working'",
    "test:priority:1": "percy exec -- cypress run --env tags='#priority-1-working'",
    "test:priority:2": "cypress run --env tags='#priority-2-working'",
    "test:priority:3": "cypress run --env tags='#priority-3-working'",
    "test:priority:4": "cypress run --env tags='#priority-4-working'"
  },
  "dependencies": {
    "@material-ui/core": "4.11.0",
    "@material-ui/icons": "4.9.1",
    "@material-ui/lab": "4.0.0-alpha.56",
    "@next/bundle-analyzer": "9.2.0",
    "@reduxjs/toolkit": "1.4.0",
    "@sentry/browser": "5.23.0",
    "@stripe/react-stripe-js": "1.1.2",
    "@stripe/stripe-js": "1.9.0",
    "dotenv": "8.2.0",
    "es6-promise": "4.2.8",
    "fetch-intercept": "2.3.1",
    "fluentvalidation-ts": "2.2.1",
    "jwt-decode": "2.2.0",
    "next": "9.5.3",
    "next-offline": "4.0.6",
    "preact": "10.4.8",
    "preact-render-to-string": "5.1.10",
    "query-string": "6.13.1",
    "react": "github:preact-compat/react#1.0.0",
    "react-dom": "github:preact-compat/react-dom#1.0.0",
    "react-lazy-hydration": "0.0.10",
    "react-lazyload": "2.6.9",
    "react-redux": "7.2.1",
    "redux": "4.0.5",
    "redux-saga": "1.1.3",
    "sitemap": "6.3.0",
    "typescript": "3.9.7",
    "webpack": "4.41.2"
  },
  "devDependencies": {
    "@cypress/code-coverage": "2.0.5",
    "@percy/cypress": "2.3.2",
    "@types/chai": "4.2.12",
    "@types/jwt-decode": "2.2.1",
    "@types/lodash": "4.14.160",
    "@types/mocha": "5.2.7",
    "@types/node": "12.12.58",
    "@types/react": "16.9.49",
    "@types/react-dom": "16.9.8",
    "@types/react-lazyload": "2.6.0",
    "@types/react-redux": "7.1.9",
    "cross-blob": "2.0.0",
    "cross-env": "6.0.3",
    "cypress": "5.3.0",
    "cypress-file-upload": "4.1.0",
    "cypress-pipe": "2.0.0",
    "cypress-react-unit-test": "4.16.0",
    "formdata-node": "2.4.0",
    "isomorphic-unfetch": "3.0.0",
    "istanbul-instrumenter-loader": "3.0.1",
    "istanbul-lib-coverage": "2.0.5",
    "nyc": "14.1.1",
    "schema-dts": "0.5.3",
    "start-server-and-test": "1.11.3"
  },
  "nyc": {
    "reporter": [
      "html",
      "cobertura"
    ]
  }
}